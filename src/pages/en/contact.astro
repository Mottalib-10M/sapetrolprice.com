---
import PageLayout from '../../layouts/PageLayout.astro';
import { route } from '../../i18n/routes';
import { CONTACT_EMAIL } from '../../data/site-config';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to SA Petrol Price about a fuel figure, a levy or a rate that changed. E-mail only: nothing sold, nothing passed on to a fuel company, a bank or a lender.';
---
<PageLayout title="Contact SA Petrol Price: report a figure that moved" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <article class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>By e-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form and no phone line, and nothing you write is passed on to anyone.</p>
    <h2>What helps us most</h2>
    <ul>
      <li>A new statement or daily sheet of the Central Energy Fund, with its date.</li>
      <li>A figure we read wrong: quote the document that says otherwise.</li>
      <li>A change of the levy relief announced by the Minister of Finance.</li>
      <li>Embedding the estimate on a club, fleet or community page: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not sell fuel or loans, give financial advice, or say what your own bank will charge you. Your bank and your bond agreement decide your rate.</p>
  </article>
</PageLayout>
