---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/petrol-price/" title="Next month's petrol price estimate, South Africa" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the petrol price estimate for next month" description="Clubs, fleets and community pages can embed the estimate of next month's petrol, diesel and paraffin prices in South Africa in one iframe line. No cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the estimate', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the estimate' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the petrol price estimate</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. The frame shows the figures of the site, with their date.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the calculator visible, do not alter the frame, and do not place it next to a loan or lead form. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Next month's fuel price estimate</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/petrol-price/" title="Next month's petrol price estimate, South Africa" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
